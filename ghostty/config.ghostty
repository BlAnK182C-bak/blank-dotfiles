# Window
background-opacity = 0.8
window-decoration = false
title = "Ze Ghost of Ze Blinkus of ze blonkus"
confirm-close-surface = false

# Scrollback
scrollback-limit = 10000

# Font
font-family = monospace
font-size = 12

# Cursor
cursor-style = underline
cursor-style-blink = false

# Mouse
mouse-hide-while-typing = true

# Colors — injected by set-dynamic-theme.sh
background = #1e1e1e
foreground = #c5d1dc
cursor-color = #c5d1dc
cursor-text = #1e1e1e
selection-background = #476584
selection-foreground = #1e1e1e

# Palette (normal colors 0–7)
palette = 0=#1e1e1e
palette = 1=BF616A
palette = 2=A3BE8C
palette = 3=#476584
palette = 4=#476584
palette = 5=#476584
palette = 6=#c5d1dc
palette = 7=#c5d1dc

# Palette (bright colors 8–15)
palette = 8=#476584
palette = 9=BF616A
palette = 10=A3BE8C
palette = 11=#c5d1dc
palette = 12=#c5d1dc
palette = 13=#c5d1dc
palette = 14=#c5d1dc
palette = 15=#c5d1dc

# Keybinds
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+f=inspector:toggle
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom

